# OpenFGA Configuration
# Copy this file to .env and fill in your values

# OpenFGA API URL
OPENFGA_API_URL=http://localhost:8080

# OpenFGA Store ID (required)
# Get this from: fga store list
OPENFGA_STORE_ID=01HQXYZ123456789ABCDEF

# OpenFGA Authorization Model ID (optional - uses latest if not specified)
# Get this from: fga model list --store-id=<STORE_ID>
OPENFGA_MODEL_ID=

# Relation to check (default: can_access)
# This MUST match a relation defined in your OpenFGA model
# Common examples: can_use, can_access, viewer, editor, reader
OPENFGA_RELATION=can_use
